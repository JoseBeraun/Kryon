<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Kryon.Core\Kryon.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
  </ItemGroup>

  <!--
    Corrección de seguridad de una dependencia transitiva (NU1902/NU1903; GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx):
    Microsoft.EntityFrameworkCore.SqlServer 10.0.12 → Microsoft.Data.SqlClient 6.1.6 → System.Security.Cryptography.Pkcs
    9.0.11 (vulnerable). SqlClient 6.1.7, el que trae EF Core 10.0.13, sigue pidiendo 9.0.11, así que se fija aquí la
    versión corregida (10.0.13, compatible con el mínimo >= 9.0.11 de SqlClient). Kryon.Api y Kryon.Api.Tests la heredan
    por su referencia a este proyecto. Quitar cuando SqlClient dependa ya de una versión corregida.
  -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
