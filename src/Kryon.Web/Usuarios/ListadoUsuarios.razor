@page "/usuarios"
@using Kryon.Contracts.Usuarios
@using Kryon.Web.Compartido
@implements IDisposable
@inject ClienteUsuarios Cliente
@inject NavigationManager Navegacion

@*
    Listado de usuarios (contracts/ui-usuarios.md → Listado). La búsqueda, los filtros y la página se leen de la query
    string y se escriben en ella (FR-018, FR-022). La interfaz no decide permisos: las acciones de cada fila y
    "Nuevo usuario" salen solo de `acciones` y `puedeRegistrar` de la API (FR-007).
*@

<PageTitle>Usuarios</PageTitle>

<h1>Usuarios</h1>

<Mensajes Exito="@anuncio" Error="@error" />

@* Sin una respuesta correcta de la API (sin permiso, otro error o fallo de red) no se muestran datos (FR-005, FR-042). *@
@if (resultado is not null)
{
    @if (resultado.PuedeRegistrar)
    {
        <button type="button" @onclick="IrANuevoUsuario">Nuevo usuario</button>
    }

    <FiltrosUsuarios Busqueda="@Busqueda" RolId="@RolId" Estado="@Estado" AlCambiar="AplicarCriterios" />

    @if (resultado.Total == 0)
    {
        @* Sin resultados con criterios (EC-11) frente a estado vacío sin criterios (FR-013). *@
        <p>@(HayCriterios ? "No hay usuarios que coincidan con la búsqueda y los filtros" : "No hay usuarios que mostrar")</p>
    }
    else
    {
        <table class="listado-usuarios">
            <caption>Usuarios de la empresa</caption>
            <thead>
                <tr>
                    <th scope="col">Nombre</th>
                    <th scope="col">Identificador de acceso</th>
                    <th scope="col">Rol</th>
                    <th scope="col">Estado</th>
                    <th scope="col">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var usuario in resultado.Elementos)
                {
                    <tr @key="usuario.Id">
                        <td class="texto-extenso">
                            @usuario.NombreCompleto
                            @if (usuario.EsCuentaPropia)
                            {
                                <span class="cuenta-propia">Tú</span>
                            }
                        </td>
                        <td class="texto-extenso">@usuario.IdentificadorAcceso</td>
                        <td>@(usuario.Rol?.Nombre ?? "Sin rol asignado")</td>
                        <td>@TextoEstado(usuario.Estado)</td>
                        <td>
                            @if (usuario.Acciones.VerDetalle)
                            {
                                <a href="@($"usuarios/{usuario.Id}")" aria-label="@($"Ver detalle de {usuario.NombreCompleto}")">Ver detalle</a>
                            }
                            @if (usuario.Acciones.Editar)
                            {
                                <a href="@($"usuarios/{usuario.Id}/editar")" aria-label="@($"Editar a {usuario.NombreCompleto}")">Editar</a>
                            }
                            @* Activar y desactivar se conectan con la API en US2 (T057 y siguientes). *@
                            @if (usuario.Acciones.Activar)
                            {
                                <button type="button" aria-label="@($"Activar a {usuario.NombreCompleto}")">Activar</button>
                            }
                            @if (usuario.Acciones.Desactivar)
                            {
                                <button type="button" aria-label="@($"Desactivar a {usuario.NombreCompleto}")">Desactivar</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <PaginacionUsuarios Pagina="@resultado.Pagina" TamanoPagina="@resultado.TamanoPagina" Total="@resultado.Total" AlCambiarPagina="IrAPagina" />
    }
}

@code {
    /// <summary>Búsqueda parcial (parámetro <c>busqueda</c> del contrato).</summary>
    [SupplyParameterFromQuery(Name = "busqueda")]
    public string? Busqueda { get; set; }

    [SupplyParameterFromQuery(Name = "rolId")]
    public string? RolId { get; set; }

    /// <summary><c>activo</c> o <c>inactivo</c>; la API rechaza cualquier otro valor.</summary>
    [SupplyParameterFromQuery(Name = "estado")]
    public string? Estado { get; set; }

    [SupplyParameterFromQuery(Name = "pagina")]
    public string? Pagina { get; set; }

    [SupplyParameterFromQuery(Name = "tamanoPagina")]
    public string? TamanoPagina { get; set; }

    private PaginaUsuarios? resultado;
    private string? anuncio;
    private string? error;
    private string? criteriosCargados;
    private CancellationTokenSource? carga;

    protected override async Task OnParametersSetAsync()
    {
        // Solo se vuelve a cargar si cambió la query string, no en cada renderizado del padre.
        var criterios = $"{Busqueda}|{RolId}|{Estado}|{Pagina}|{TamanoPagina}";
        if (criterios == criteriosCargados)
        {
            return;
        }

        var esCambio = criteriosCargados is not null;
        criteriosCargados = criterios;

        carga?.Cancel();
        carga?.Dispose();
        carga = new CancellationTokenSource();
        var cancelacion = carga.Token;

        try
        {
            var respuesta = await Cliente.ListarUsuariosAsync(
                string.IsNullOrEmpty(Busqueda) ? null : Busqueda,
                Guid.TryParse(RolId, out var rol) ? rol : null,
                string.IsNullOrEmpty(Estado) ? null : Estado,
                int.TryParse(Pagina, out var numero) ? numero : null,
                int.TryParse(TamanoPagina, out var tamano) ? tamano : null,
                cancelacion);

            // Cualquier rechazo de la API (sin-permiso incluido) se muestra con el texto de su código, sin datos.
            resultado = respuesta.EsCorrecta ? respuesta.Valor : null;
            error = respuesta.EsCorrecta ? null : TextosErrores.ParaCodigo(respuesta.CodigoError);

            // El anuncio se hace cuando cambian la búsqueda, los filtros o la página (FR-019).
            anuncio = esCambio && resultado is not null ? $"{resultado.Total} usuarios encontrados" : anuncio;
        }
        catch (OperationCanceledException) when (cancelacion.IsCancellationRequested)
        {
            // Una carga más reciente sustituyó a esta.
        }
        catch (HttpRequestException)
        {
            // Sin respuesta no se sabe el resultado: no se muestra ningún estado no confirmado (FR-042, EC-8).
            resultado = null;
            error = TextosErrores.SinRespuesta;
        }
    }

    private bool HayCriterios =>
        !string.IsNullOrEmpty(Busqueda) || !string.IsNullOrEmpty(RolId) || !string.IsNullOrEmpty(Estado);

    /// <summary>
    /// Escribe la búsqueda y los filtros en la query string y vuelve a la primera página; el listado se recarga desde
    /// ella. Los parámetros vacíos se quitan y el resto de la query (como <c>tamanoPagina</c>) se conserva.
    /// </summary>
    private void AplicarCriterios(FiltrosUsuarios.CriteriosUsuarios criterios) =>
        Navegacion.NavigateTo(Navegacion.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["busqueda"] = string.IsNullOrEmpty(criterios.Busqueda) ? null : criterios.Busqueda,
            ["rolId"] = string.IsNullOrEmpty(criterios.RolId) ? null : criterios.RolId,
            ["estado"] = string.IsNullOrEmpty(criterios.Estado) ? null : criterios.Estado,
            ["pagina"] = null,
        }));

    /// <summary>Cambia solo la página en la query string y conserva los criterios.</summary>
    private void IrAPagina(int pagina) =>
        Navegacion.NavigateTo(Navegacion.GetUriWithQueryParameter("pagina", pagina > 1 ? pagina : null));

    private void IrANuevoUsuario() => Navegacion.NavigateTo("usuarios/nuevo");

    /// <summary>Texto del estado del contrato (FR-010). Un valor que el contrato no define se muestra tal cual.</summary>
    private static string TextoEstado(string estado) => estado switch
    {
        "activo" => "Activo",
        "inactivo" => "Inactivo",
        _ => estado,
    };

    public void Dispose()
    {
        carga?.Cancel();
        carga?.Dispose();
    }
}
