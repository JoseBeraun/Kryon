{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Seguridad": {
    "Permisos": {
      "Usuarios.Acceder": "usuarios.administrar",
      "Usuarios.Registrar": "usuarios.registrar",
      "Usuarios.Editar": "usuarios.editar",
      "Usuarios.Activar": "usuarios.activar",
      "Usuarios.Desactivar": "usuarios.desactivar"
    }
  },
  "Usuarios": {
    "Paginacion": {
      "TamanoPorDefecto": 25,
      "TamanoMaximo": 100
    },
    "Validacion": {
      "LongitudMaximaNombre": 200,
      "LongitudMaximaIdentificador": 256
    }
  }
}
